@page "/schedule/resources/timelineyear"
@using Syncfusion.Blazor.Schedule
@using System.Diagnostics

<div class="performance-container">
    <div class="view-header">
        <h2>Performance Sample - Resource Scheduler Timeline Year (500 Resources, 15000 Events)</h2>
        <p class="view-description">Resource scheduler timeline year view with 500 resources and 15000 events rendered in viewport - multi-resource performance monitoring</p>
    </div>

    <div class="performance-metrics-panel">
        <div class="metrics-header">Performance Metrics</div>
        <div class="metrics-content">
            <div class="metric-row">
                <span class="metric-label">Initial Load Time</span>
                <span class="metric-value">@(isRendered? initialLoadTimer.Elapsed.TotalMilliseconds.ToString("F2") : "0.00") ms</span>
            </div>
            <div class="metric-row">
                <span class="metric-label">Create Event Time</span>
                <span class="metric-value">@(createEventTime > 0 ? createEventTime.ToString("F2") : "0.00") ms</span>
            </div>
            <div class="metric-row">
                <span class="metric-label">Edit Event Time</span>
                <span class="metric-value">@(editEventTime > 0 ? editEventTime.ToString("F2") : "0.00") ms</span>
            </div>
            <div class="metric-row">
                <span class="metric-label">Delete Event Time</span>
                <span class="metric-value">@(deleteEventTime > 0 ? deleteEventTime.ToString("F2") : "0.00") ms</span>
            </div>
            <div class="metric-row">
                <span class="metric-label">Total Resources</span>
                <span class="metric-value">@ResourceDatasource.Count</span>
            </div>
            <div class="metric-row">
                <span class="metric-label">Total Appointments</span>
                <span class="metric-value">@AppointmentData.Count</span>
            </div>
        </div>
    </div>

    <div class="schedule-wrapper">
        <SfSchedule TValue="EventDataModel"
                    Width="100%"
                    Height="1000px"
                    @bind-CurrentView="@CurrentView"
                    @bind-SelectedDate="@CurrentDate"
                    AllowDragAndDrop="true"
                    AllowResizing="true">
            <ScheduleGroup EnableCompactView="false" Resources="@GroupData"></ScheduleGroup>
            <ScheduleResources>
                <ScheduleResource TItem="ResourceDataModel"
                                  TValue="int"
                                  DataSource="@ResourceDatasource"
                                  Field="ResourceId"
                                  Title="Resource"
                                  Name="Resources"
                                  TextField="ResourceName"
                                  IdField="ResourceId"
                                  ColorField="ResourceColor">
                </ScheduleResource>
            </ScheduleResources>
            <ScheduleViews>
                <ScheduleView Option="View.TimelineYear" AllowVirtualScrolling=true></ScheduleView>
            </ScheduleViews>
            <ScheduleEvents TValue="EventDataModel"
                            Created="OnCreated"
                            OnActionBegin="OnActionBegin"
                            ActionCompleted="OnActionCompleted"
                            DataBound="OnDataBound">
            </ScheduleEvents>
            <ScheduleEventSettings DataSource="@AppointmentData"></ScheduleEventSettings>
        </SfSchedule>
    </div>
</div>

<style>
    .performance-container {
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1600px;
        margin: 0 auto;
    }

    .view-header {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #4472c4;
    }

        .view-header h2 {
            margin: 0 0 5px 0;
            color: #333;
            font-size: 28px;
            font-weight: 600;
        }

    .view-description {
        margin: 5px 0 0 0;
        color: #666;
        font-size: 14px;
    }

    .schedule-wrapper {
        margin: 20px 0;
        border: 1px solid #ddd;
        border-radius: 4px;
        overflow: hidden;
        background: #fff;
    }

    .performance-metrics-panel {
        background: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .metrics-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 12px 16px;
        font-weight: 600;
        font-size: 13px;
    }

    .metrics-content {
        padding: 16px;
    }

    .metric-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #e0e0e0;
        font-size: 13px;
    }

        .metric-row:last-child {
            border-bottom: none;
        }

    .metric-label {
        color: #666;
        font-weight: 500;
    }

    .metric-value {
        color: #667eea;
        font-weight: 600;
        font-family: 'Monaco', 'Courier New', monospace;
    }

    @@media (max-width: 768px) {
        .performance-container {
            padding: 10px;
            max-width: 100%;
        }

        .view-header h2 {
            font-size: 20px;
        }

        .schedule-wrapper {
            margin: 10px 0;
        }
    }
</style>

@code {
    View CurrentView = View.TimelineYear;
    DateTime CurrentDate = new DateTime(DateTime.Now.Year, 1, 1);
    public List<EventDataModel> AppointmentData = new List<EventDataModel>();
    public List<ResourceDataModel> ResourceDatasource = new List<ResourceDataModel>();
    public string[] GroupData { get; set; } = { "Resources" };

    private Stopwatch initialLoadTimer = new Stopwatch();
    private Stopwatch interactionTimer = new Stopwatch();
    private double createEventTime = 0;
    private double editEventTime = 0;
    private double deleteEventTime = 0;
    private bool isRendered = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        initialLoadTimer.Start();

        // Generate 500 resources and 15000 events
        ResourceDatasource = GenerateResources(500);
        AppointmentData = GenerateAppointmentsForResourceScheduler(15000, ResourceDatasource);
    }

    private async Task OnCreated()
    {
        await Task.Yield();
        if (!isRendered)
        {
            isRendered = true;
            initialLoadTimer.Stop();
        }
    }

    private void OnActionBegin(ActionEventArgs<EventDataModel> args)
    {
        interactionTimer.Restart();
    }

    private async Task OnActionCompleted(ActionEventArgs<EventDataModel> args)
    {
        await Task.Yield();
        interactionTimer.Stop();

        if (args.ActionType == ActionType.EventCreate)
        {
            createEventTime = interactionTimer.Elapsed.TotalMilliseconds;
        }
        else if (args.ActionType == ActionType.EventChange)
        {
            editEventTime = interactionTimer.Elapsed.TotalMilliseconds;
        }
        else if (args.ActionType == ActionType.EventRemove)
        {
            deleteEventTime = interactionTimer.Elapsed.TotalMilliseconds;
        }
    }

    private async Task OnDataBound(DataBoundEventArgs<EventDataModel> args)
    {
        await Task.Yield();
        if (!isRendered)
        {
            isRendered = true;
            initialLoadTimer.Stop();
        }
    }

    private List<ResourceDataModel> GenerateResources(int count)
    {
        List<ResourceDataModel> resources = new List<ResourceDataModel>();
        string[] colors = { "#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A", "#98D8C8",
                           "#F7DC6F", "#BB8FCE", "#85C1E2", "#F8B88B", "#52C4A1" };
        string[] buildings = { "A", "B", "C" };

        for (int i = 1; i <= count; i++)
        {
            int floorNumber = ((i - 1) / 20) % 5 + 1;
            int roomNumber = ((i - 1) % 20) + 1;
            int building = (i - 1) % 3;

            resources.Add(new ResourceDataModel
            {
                ResourceId = i,
                ResourceName = $"Resource {i}",
                ResourceColor = colors[(i - 1) % colors.Length],
                ResourceCapacity = (i % 10) + 1,
                ResourceLocation = $"Building {buildings[building]}, Floor {floorNumber}, Room {roomNumber}"
            });
        }

        return resources;
    }

    private List<EventDataModel> GenerateAppointmentsForResourceScheduler(int count, List<ResourceDataModel> resources)
    {
        List<EventDataModel> appointments = new List<EventDataModel>();
        Random random = new Random(42); // Fixed seed for reproducibility

        string[] subjects = {
            "Team Standup", "Client Meeting", "Code Review", "Design Discussion", "Planning Session",
            "Development Task", "Testing", "Documentation", "Debugging Session", "Architecture Review",
            "Sprint Review", "Retrospective", "One-on-One", "Training Session", "Brainstorming",
            "Team Building", "Project Kickoff", "Budget Review", "Performance Review", "Strategy Session",
            "Workshop", "Conference Call", "Demo Preparation", "Deployment", "Maintenance",
            "Security Audit", "Database Optimization", "API Review", "Load Testing", "Backup Verification"
        };

        DateTime baseDate = new DateTime(DateTime.Now.Year, 1, 1);
        int maxDay = DateTime.IsLeapYear(DateTime.Now.Year) ? 366 : 365;

        for (int i = 0; i < count; i++)
        {
            // Distribute events evenly across resources
            int resourceIndex = i % resources.Count;

            // Distribute events across entire year (0-364/365)
            // This ensures all 365 days get events
            int eventsPerDay = count / maxDay;
            int dayOffset = (i / eventsPerDay) % maxDay;

            // Random time within business hours (8 AM - 6 PM)
            int hour = random.Next(8, 18);
            int minute = random.Next(0, 60);
            int duration = random.Next(15, 60);

            DateTime startTime = baseDate.AddDays(dayOffset).AddHours(hour).AddMinutes(minute);
            DateTime endTime = startTime.AddMinutes(duration);

            appointments.Add(new EventDataModel
            {
                Id = i + 1,
                Subject = subjects[random.Next(subjects.Length)],
                StartTime = startTime,
                EndTime = endTime,
                ResourceId = resources[resourceIndex].ResourceId,
                Description = $"Performance Test Event {i + 1}",
                Location = resources[resourceIndex].ResourceLocation
            });
        }

        return appointments;
    }

    public class EventDataModel
    {
        public int Id { get; set; }
        public string Subject { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
        public string Description { get; set; }
        public string Location { get; set; }
        public bool IsAllDay { get; set; }
        public string RecurrenceRule { get; set; }
        public string RecurrenceException { get; set; }
        public int? RecurrenceID { get; set; }
        public int ResourceId { get; set; }
    }

    public class ResourceDataModel
    {
        public int ResourceId { get; set; }
        public string ResourceName { get; set; }
        public string ResourceColor { get; set; }
        public int ResourceCapacity { get; set; }
        public string ResourceLocation { get; set; }
    }
}
